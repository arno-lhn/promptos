---
import '../styles/global.css';
interface Props { title: string; description?: string; workshop?: boolean; }
const { title, description = 'Un atelier pédagogique pour apprendre à construire vos prompts. Sans compte, sans IA intégrée : simplement vos idées, mieux structurées.', workshop = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F8F6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — PromptOS</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="PromptOS, accueil"><span class="brand-icon" aria-hidden="true">[<span>↗</span>]</span><span>Prompt<span class="brand-os">OS</span><span class="brand-dot">.</span></span></a>
        <nav class="main-nav" aria-label="Navigation principale"><a href="/" aria-current={!workshop ? 'page' : undefined}>Accueil</a><a href="/atelier/" aria-current={workshop ? 'page' : undefined}>L’Atelier <span aria-hidden="true">↗</span></a></nav>
        <span class="header-tag"><span class="local-dot"></span> L’intention avant la formule.</span>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><a class="footer-brand" href="/">PromptOS<span>.</span></a><p>Apprendre à demander, pour mieux créer.</p><span>Atelier pédagogique · Version 1.0</span></div></footer>
  </body>
</html>
